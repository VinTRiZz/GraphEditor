# Check-secrets rules: passwords and credentials.
#
# See tokens.rules for the rule-file format.

[password-assignment]
type = regex
pattern = (?i)(?:^|[^\w.-])["']?(?:(?:[A-Za-z0-9]+[_-])?(?:password|passwd|passphrase)|(?-i:(?:[a-z][A-Za-z0-9]*)?(?:Password|Passwd|Passphrase)|dbPass|smtpPass|userPass|ftpPass|apiPass|appPass|dbPwd|smtpPwd|userPwd|ftpPwd))["']?\s*[:=]\s*(?P<value>"(?:\\.|[^"\\]){3,}"|'(?:\\.|[^'\\]){3,}'|[^\s#;,]{3,})
description = Password value assigned to a password-named field

[prefixed-short-password-assignment]
type = regex
pattern = (?i)(?:^|[^\w.-])["']?[A-Za-z0-9]+[_-](?:pwd|pass)["']?\s*[:=]\s*(?P<value>"(?:\\.|[^"\\]){3,}"|'(?:\\.|[^'\\]){3,}'|[^\s#;,]{3,})
description = Password value assigned to a prefixed short password field

[password-in-url]
type = regex
pattern = \b[a-z][a-z0-9+.-]*://[^/\s@]*:(?P<value>[^/\s@]+)@
description = Password embedded in a URL

[database-url]
type = regex
pattern = (?i)\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\+srv)?|redis|amqp)://[^/\s@]*:(?P<value>[^/\s@]+)@
description = Database connection string with a password

[basic-auth-header]
type = regex
pattern = (?i)(?:^|[^\w.-])["']?authorization["']?\s*[:=]\s*["']?basic\s+(?P<value>[A-Za-z0-9+/=]{8,})["']?
description = HTTP Basic authorization header
